{
  "name": "trace-explorer",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=22", "pnpm": ">=10" },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "data:validate": "tsx tools/validate-data/index.ts",
    "data:export": "tsx tools/export-static/index.ts",
    "data:publish": "tsx tools/export-static/publish.ts",
    "build": "pnpm data:export && pnpm --filter @trace/explorer build",
    "dev": "pnpm data:export && pnpm --filter @trace/explorer dev",
    "dev:admin": "pnpm --filter @trace/admin dev",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm data:validate && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@trace/core": "workspace:*",
    "@trace/data": "workspace:*",
    "@trace/schemas": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12"
  }
}
